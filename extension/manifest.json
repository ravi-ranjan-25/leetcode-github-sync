{
  "manifest_version": 3,
  "name": "LeetCode to GitHub Sync",
  "version": "1.6.0",
  "description": "Commits your accepted LeetCode solutions to one GitHub repo.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.github.com/*", "https://api.anthropic.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["markdown.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LeetCode to GitHub Sync"
  }
}
